    private void fillByMap(String colKey, String value, String colLabel) {
        if (!tdMap.containsKey(colKey)) {
            System.out.println("  WARNING: No TD found for: " + colLabel);
            return;
        }
        System.out.println("  Filling [" + colLabel + "] at td[" + tdMap.get(colKey) + "]");
        enterText(tdMap.get(colKey), value);
    }

    // ─────────────────────────────────────────────────────────────
    // READ EXCEL  (now also extracts embedded images to temp files)
    //
    // Excel column layout (col index, 0-based):
    //   0=Item  1=PartNumber  2=PartName  3=PartPicture(image)
    //   4=Resin  5=Cav  6=InjSystem  7=Gate  8=EAU  9=Steel
    //   10=Ejection  11=MoldFeatures  12=TargetPrice  13=CADFile  14=Notes
    //
    // readExcelData skips col[0] (Item) and reads cols 1-14 as text,
    // giving rowData[0..12] mapped to:
    //   [0]=PartNumber [1]=PartName [2]=Resin [3]=Cav [4]=InjSystem
    //   [5]=Gate [6]=EAU [7]=Steel [8]=Ejection [9]=MoldFeatures
    //   [10]=TargetPrice [11]=CADFile [12]=Notes
    //
    // Images (col=3, 0-based) are extracted separately into imageMap.
    // ─────────────────────────────────────────────────────────────

    public String[][] readExcelData(String filePath) throws Exception {
        File file = new File(filePath);
        System.out.println("Reading Excel: " + file.getAbsolutePath());

        FileInputStream fis      = new FileInputStream(file);
        XSSFWorkbook    workbook = new XSSFWorkbook(fis);
        Sheet           sheet    = workbook.getSheetAt(0);
        DataFormatter   formatter = new DataFormatter();

        int rowCount = sheet.getPhysicalNumberOfRows();
        // dataCols: skip col[0]=Item AND col[3]=PartPicture (image),
        // but we still read all 13 text cols (cols 1-2, 4-14 = 13 cols)
        int dataCols = 13;
        String[][] data = new String[rowCount - 1][dataCols];

        for (int i = 1; i < rowCount; i++) {
            Row row = sheet.getRow(i);
            for (int j = 0; j < dataCols; j++) {
                // Map j → Excel col:
                //   j=0 → col 1 (PartNumber)
                //   j=1 → col 2 (PartName)
                //   j=2 → col 4 (Resin)   ← skip col 3 (picture)
                //   j=3..12 → col 5..14
                int excelCol = (j < 2) ? (j + 1) : (j + 2);
                Cell cell = (row == null) ? null : row.getCell(excelCol);
                data[i - 1][j] = (cell == null) ? "" : formatter.formatCellValue(cell);
            }
        }

        // ── Extract embedded images ───────────────────────────────
        imageMap.clear();
        String tempDir = System.getProperty("java.io.tmpdir") + File.separator + "rfq_images";
        new File(tempDir).mkdirs();

        try {
            org.apache.poi.xssf.usermodel.XSSFSheet xssfSheet =
                (org.apache.poi.xssf.usermodel.XSSFSheet) sheet;

            // Access drawings which hold the images
            org.apache.poi.xssf.usermodel.XSSFDrawing drawing = xssfSheet.getDrawingPatriarch();
            if (drawing != null) {
                for (org.apache.poi.xssf.usermodel.XSSFShape shape : drawing.getShapes()) {
                    if (shape instanceof org.apache.poi.xssf.usermodel.XSSFPicture) {
                        org.apache.poi.xssf.usermodel.XSSFPicture pic =
                            (org.apache.poi.xssf.usermodel.XSSFPicture) shape;

                        org.apache.poi.xssf.usermodel.XSSFClientAnchor anchor =
                            (org.apache.poi.xssf.usermodel.XSSFClientAnchor) pic.getAnchor();

                        // Row1 = anchor top row (0-based Excel row index)
                        // Row 0 = header, Row 1 = data row 1, etc.
                        int excelRow = anchor.getRow1(); // 0-based
                        int dataLine = excelRow;         // data-line="1" for row1, "2" for row2...

                        org.apache.poi.xssf.usermodel.XSSFPictureData picData = pic.getPictureData();
                        String ext = picData.suggestFileExtension(); // "png", "jpg", etc.
                        byte[] imgBytes = picData.getData();

                        String imgPath = tempDir + File.separator
                            + "part_image_row" + dataLine + "." + ext;
                        try (FileOutputStream fos = new FileOutputStream(imgPath)) {
                            fos.write(imgBytes);
                        }
                        imageMap.put(dataLine, imgPath);
                        System.out.println("  Extracted image: data-line=" + dataLine
                            + " → " + imgPath + " (" + imgBytes.length + " bytes)");
                    }
                }
            }
        } catch (Exception e) {
            System.out.println("  [WARN] Image extraction failed: " + e.getMessage()
                + " — continuing without images");
        }

        System.out.println("  imageMap: " + imageMap.keySet());

        workbook.close();
        fis.close();
        System.out.println("Total rows read: " + (rowCount - 1));
        return data;
    }

    /** Returns the image map so the step definition can access it if needed. */
    public Map<Integer, String> getImageMap() {
        return Collections.unmodifiableMap(imageMap);
    }

