    public boolean isEmailSentSuccessfully() {
        try {
            wait.until(ExpectedConditions.visibilityOfElementLocated(
                By.xpath("//*[contains(text(),'Email sent') or "
                    + "contains(text(),'Success') or "
                    + "contains(text(),'sent successfully')]")));
            return true;
        } catch (Exception e) {
            return driver.getPageSource().contains("sent")
                || driver.getPageSource().contains("Success");
        }
    }
