    /**
     * FIX: Improved Save button detection — checks onclick attribute too
     */
    private WebElement findSaveButton(WebElement modal) {
        // Try by onclick containing save-related functions
        List<WebElement> onclickSave = modal.findElements(
            By.xpath(".//button[contains(@onclick,'save') or contains(@onclick,'Save') or contains(@onclick,'submit')]"));
        if (!onclickSave.isEmpty()) return onclickSave.get(0);

        // Try by class
        List<WebElement> classSave = modal.findElements(
            By.xpath(".//button[contains(@class,'save') or contains(@class,'btn-primary') or contains(@class,'customtarget-save')]"));
        if (!classSave.isEmpty()) return classSave.get(0);

        // Try by text
        List<WebElement> allBtns = modal.findElements(By.tagName("button"));
        for (WebElement btn : allBtns) {
            String txt = btn.getText().trim().toLowerCase();
            String cls = (btn.getAttribute("class") != null ? btn.getAttribute("class").toLowerCase() : "");
            boolean isClose = cls.contains("close") || txt.equals("x") || txt.equals("cancel") || txt.equals("close");
            if (!isClose && !txt.isEmpty()) return btn;
        }

        // Last resort: last button
        if (!allBtns.isEmpty()) return allBtns.get(allBtns.size() - 1);
        return null;
    }

