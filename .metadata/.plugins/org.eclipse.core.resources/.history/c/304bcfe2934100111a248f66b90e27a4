    // ─────────────────────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────────────────────

    private void sleep(long ms) {
        try { Thread.sleep(ms); } catch (InterruptedException ignored) {}
    }

    private void dismissAlertIfPresent() {
        try {
            Alert alert = alertWait.until(ExpectedConditions.alertIsPresent());
            System.out.println("  [Alert] Dismissing: " + alert.getText());
            alert.accept();
        } catch (Exception ignored) {}
    }

    /**
     * FIX 1: Toastr check is fast — only waits if toastr actually exists.
     * Uses a single JS call to check and remove toastr instantly.
     */
    private void clearToastr() {
        try {
            js.executeScript(
                "var t=document.querySelector('#toast-container,.toastr,.toastr-message');" +
                "if(t){t.parentNode && t.parentNode.removeChild(t);}");
        } catch (Exception ignored) {}
    }

    private void waitForToastrToDisappear() {
        try {
            List<WebElement> toastrs = driver.findElements(
                By.cssSelector("#toast-container,.toastr,.toastr-message"));
            if (toastrs.isEmpty()) return;
            // Remove via JS immediately — don't wait 8 seconds
            clearToastr();
            sleep(150);
        } catch (Exception ignored) {}
    }

    /**
     * FIX 2: safeSendKeys — for textarea that is hidden (display:none),
     * we click the VISIBLE display element first to trigger it, then type.
     * Also uses JS setValue as fallback for ElementNotInteractableException.
     */
    private void safeSendKeys(By locator, String value) {
        for (int i = 0; i < MAX_ATTEMPTS; i++) {
            try {
                dismissAlertIfPresent();
                waitForToastrToDisappear();

                WebElement el = wait.until(ExpectedConditions.presenceOfElementLocated(locator));
                js.executeScript("arguments[0].scrollIntoView({block:'center'});", el);
                sleep(80);

                // Try normal interaction first
                try {
                    // Check if element is actually interactable
                    if (!el.isDisplayed() || !el.isEnabled()) {
                        // Use JS to set value directly
                        jsSetAndFire(el, value);
                        System.out.println("    [JS-set] Used JS for hidden/disabled element");
                        return;
                    }
                    try { el.click(); } catch (ElementClickInterceptedException e2) {
                        clearToastr();
                        sleep(100);
                        js.executeScript("arguments[0].click();", el);
                    }
                    el.clear();
                    el.sendKeys(value);
                    fireEvents(el);
                    return;
                } catch (ElementNotInteractableException e) {
                    // FIX: Element not interactable — use JS setValue
                    System.out.println("    [NotInteractable] Using JS setValue for: " + locator);
                    jsSetAndFire(el, value);
                    return;
                }
            } catch (StaleElementReferenceException e) {
                System.out.println("  [StaleRetry] safeSendKeys attempt " + (i + 1) + " for: " + locator);
                sleep(300);
            }
        }
        throw new RuntimeException("safeSendKeys failed after " + MAX_ATTEMPTS + " attempts: " + locator);
    }

    private void jsSetAndFire(WebElement el, String value) {
        js.executeScript(
            "arguments[0].value=arguments[1];" +
            "arguments[0].dispatchEvent(new Event('focus',{bubbles:true}));" +
            "arguments[0].dispatchEvent(new Event('input',{bubbles:true}));" +
            "arguments[0].dispatchEvent(new Event('change',{bubbles:true}));" +
            "arguments[0].dispatchEvent(new Event('blur',{bubbles:true}));",
            el, value);
    }

    private void fireEvents(WebElement el) {
        js.executeScript(
            "arguments[0].dispatchEvent(new Event('input',{bubbles:true}));" +
            "arguments[0].dispatchEvent(new Event('change',{bubbles:true}));", el);
    }

    private void safeJsSetValue(By locator, String value) {
        for (int i = 0; i < MAX_ATTEMPTS; i++) {
            try {
                WebElement el = driver.findElement(locator);
                jsSetAndFire(el, value);
                return;
            } catch (StaleElementReferenceException e) {
                System.out.println("  [StaleRetry] safeJsSetValue attempt " + (i + 1));
                sleep(300);
            }
        }
    }

    private void waitForDom() {
        dismissAlertIfPresent();
        wait.until(d -> js.executeScript("return document.readyState").equals("complete"));
    }

