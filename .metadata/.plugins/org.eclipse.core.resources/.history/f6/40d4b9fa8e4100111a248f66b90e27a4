    private static final int MAX_ATTEMPTS = 3;

    // ─────────────────────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────────────────────

    private void sleep(long ms) {
        try { Thread.sleep(ms); } catch (InterruptedException ignored) {}
    }

    private void dismissAlertIfPresent() {
        try {
            Alert alert = alertWait.until(ExpectedConditions.alertIsPresent());
            System.out.println("  [Alert] Dismissing: " + alert.getText());
            alert.accept();
        } catch (Exception ignored) {}
    }

    // Fast toastr check: only blocks if toastr is actually present
    private void waitForToastrToDisappear() {
        try {
            List<WebElement> t = driver.findElements(
                By.cssSelector(".toastr-message, .toastr, #toast-container"));
            if (t.isEmpty()) return;
            new WebDriverWait(driver, Duration.ofSeconds(8))
                .until(ExpectedConditions.invisibilityOfElementLocated(
                    By.cssSelector(".toastr-message, .toastr, #toast-container")));
        } catch (Exception ignored) {}
    }

    // ── KEY FIX: poll-based modal close check ────────────────────
    private boolean isModalClosed(By modalBy) {
        try {
            List<WebElement> m = driver.findElements(modalBy);
            return m.isEmpty() || !m.get(0).isDisplayed();
        } catch (Exception e) {
            return true;
        }
    }

    private void safeSendKeys(By locator, String value) {
        for (int i = 0; i < MAX_ATTEMPTS; i++) {
            try {
                dismissAlertIfPresent();
                waitForToastrToDisappear();
                WebElement el = wait.until(ExpectedConditions.presenceOfElementLocated(locator));
                ((JavascriptExecutor) driver).executeScript(
                    "arguments[0].scrollIntoView({block:'center'});", el);
                try {
                    el.click();
                } catch (ElementClickInterceptedException ex) {
                    System.out.println("  [ClickIntercepted] JS click fallback: " + locator);
                    waitForToastrToDisappear();
                    ((JavascriptExecutor) driver).executeScript("arguments[0].click();", el);
                }
                el.clear();
                el.sendKeys(value);
                ((JavascriptExecutor) driver).executeScript(
                    "arguments[0].dispatchEvent(new Event('input',{bubbles:true}));"
                    + "arguments[0].dispatchEvent(new Event('change',{bubbles:true}));", el);
                return;
            } catch (StaleElementReferenceException e) {
                System.out.println("  [StaleRetry] safeSendKeys attempt " + (i + 1) + " : " + locator);
                sleep(300);
            }
        }
        throw new RuntimeException("safeSendKeys failed after " + MAX_ATTEMPTS + " attempts: " + locator);
    }

    private void safeJsSetValue(By locator, String value) {
        for (int i = 0; i < MAX_ATTEMPTS; i++) {
            try {
                WebElement el = driver.findElement(locator);
                ((JavascriptExecutor) driver).executeScript(
                    "arguments[0].value=arguments[1];"
                    + "arguments[0].dispatchEvent(new Event('input',{bubbles:true}));"
                    + "arguments[0].dispatchEvent(new Event('change',{bubbles:true}));", el, value);
                return;
            } catch (StaleElementReferenceException e) {
                sleep(300);
            }
        }
    }

    private void waitForDom() {
        dismissAlertIfPresent();
        wait.until(d ->
            ((JavascriptExecutor) d).executeScript("return document.readyState").equals("complete"));
    }

    // ─────────────────────────────────────────────────────────────
