<!-- 
    Smoke suite — runs only @Smoke tagged scenarios (login.feature).
    Used in Jenkins when SUITE_FILE = testng-smoke.xml
    Runs fast: ~2 minutes, used as a quick sanity check on every push.
 -->
<suite name="CPS-Smoke-Suite" verbose="1" parallel="false">
<listeners>
<listener class-name="io.qameta.allure.testng.AllureTestNg"/>
</listeners>
<test name="Smoke-Tests">
<parameter name="browser" value="chrome"/>
<classes>
<class name="runners.SmokeRunner"/>
</classes>
</test>
</suite>