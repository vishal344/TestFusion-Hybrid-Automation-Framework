pipeline {
    agent any

    /*
     * Triggers:
     *   1. Every git push to the repo (via GitHub webhook)
     *   2. Every night at 2 AM as a safety net
     */
    triggers {
        githubPush()
        cron('H 2 * * *')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))   // keep last 10 builds
        timeout(time: 60, unit: 'MINUTES')               // kill hung builds
        disableConcurrentBuilds()                        // 1 build at a time
        timestamps()                                     // timestamps in console
    }

    /*
     * Parameters let you choose suite & browser from Jenkins UI
     * without editing any code.
     */
    parameters {
        choice(
            name: 'SUITE_FILE',
            choices: [
                'testng.xml',
                'testng-smoke.xml',
                'testng-regression.xml'
            ],
            description: 'Which TestNG suite to run?'
        )
        choice(
            name: 'BROWSER',
            choices: ['chrome', 'firefox'],
            description: 'Browser (headless on Jenkins)'
        )
        choice(
            name: 'TAG',
            choices: [
                '@RFQDetailsModule',
                '@Smoke',
                '@Customer',
                '@Employee',
                '@ProcurementModule',
                'all'
            ],
            description: 'Cucumber tag to run (overrides suite default)'
        )
    }

    environment {
        BASE_URL     = 'http://162.244.66.135:8989/rev-aux/buyerlogin'
        ALLURE_DIR   = 'target/allure-results'
        REPORT_DIR   = 'target/cucumber-reports'
        SCREENSHOT_DIR = 'target/screenshots'
    }

    stages {

        /* ── Stage 1: Get the code ──────────────────────────────── */
        stage('Checkout') {
            steps {
                checkout scm
                echo "Branch : ${env.GIT_BRANCH}"
                echo "Commit : ${env.GIT_COMMIT?.take(7)}"
                echo "Suite  : ${params.SUITE_FILE}"
                echo "Browser: ${params.BROWSER}"
                echo "Tag    : ${params.TAG}"
            }
        }

        /* ── Stage 2: Compile the project ──────────────────────── */
        stage('Build') {
            steps {
                sh 'mvn clean compile -q'
            }
        }

        /* ── Stage 3: Run Selenium + Cucumber + TestNG tests ────── */
        stage('Run Tests') {
            steps {
                script {
                    /*
                     * Build the maven command.
                     * -DsuiteFile  → picked up by <suiteXmlFile>${suiteFile}</suiteXmlFile>
                     * -Dbrowser    → picked up by DriverManager.initDriver()
                     * -DbaseUrl    → picked up by Hooks.launchBrowser()
                     * -Dtag        → passed to TestRunner @CucumberOptions if needed
                     *
                     * testFailureIgnore=true in pom.xml means mvn exits 0
                     * even when tests fail — Allure report is still generated.
                     * The Quality Gate stage below reads results and fails the
                     * build properly.
                     */
                    def tagFilter = (params.TAG == 'all') ? '' : "-Dcucumber.filter.tags=${params.TAG}"

                    sh """
                        mvn test \
                          -DsuiteFile=${params.SUITE_FILE} \
                          -Dbrowser=${params.BROWSER} \
                          -DbaseUrl=${env.BASE_URL} \
                          ${tagFilter} \
                          -q
                    """
                }
            }
            post {
                always {
                    echo 'Test execution finished — moving to report generation'
                }
            }
        }

        /* ── Stage 4: Publish Allure HTML report in Jenkins ─────── */
        stage('Allure Report') {
            steps {
                allure([
                    includeProperties: false,
                    jdk: '',
                    results: [[path: "${env.ALLURE_DIR}"]]
                ])
            }
        }

        /* ── Stage 5: Quality Gate ──────────────────────────────── */
        /*
         * Reads target/surefire-reports/testng-results.xml (created by TestNG).
         * If any test failed → marks build FAILURE.
         * This gives us: full Allure report + correct build status.
         */
        stage('Quality Gate') {
            steps {
                script {
                    def exitCode = sh(
                        script: '''
python3 -c "
import xml.etree.ElementTree as ET, glob, sys

files = glob.glob('target/surefire-reports/testng-results.xml')
if not files:
    print('No testng-results.xml found — skipping gate')
    sys.exit(0)

root = ET.parse(files[0]).getroot()
total   = int(root.get('total',   0))
passed  = int(root.get('passed',  0))
failed  = int(root.get('failed',  0))
skipped = int(root.get('skipped', 0))

print(f'Results  =>  Total: {total}  Passed: {passed}  Failed: {failed}  Skipped: {skipped}')

if failed > 0:
    print(f'QUALITY GATE FAILED: {failed} test(s) failed')
    sys.exit(1)

print('QUALITY GATE PASSED')
sys.exit(0)
"
                        ''',
                        returnStatus: true
                    )

                    if (exitCode != 0) {
                        currentBuild.result = 'FAILURE'
                        error('Quality gate failed — see Allure report for details')
                    }
                }
            }
        }
    }

    /* ── Post-build actions (always run) ─────────────────────────── */
    post {

        success {
            echo 'BUILD PASSED'
            slackSend(
                channel: '#qa-automation',
                color: 'good',
                message: """
*PASSED* — CPS Automation #${env.BUILD_NUMBER}
Branch : `${env.GIT_BRANCH}`
Suite  : `${params.SUITE_FILE}`
Browser: `${params.BROWSER}`
Tag    : `${params.TAG}`
<${env.BUILD_URL}allure|Allure Report> | <${env.BUILD_URL}|Jenkins>
                """.stripIndent().trim()
            )
        }

        failure {
            echo 'BUILD FAILED'
            slackSend(
                channel: '#qa-automation',
                color: 'danger',
                message: """
*FAILED* — CPS Automation #${env.BUILD_NUMBER}
Branch : `${env.GIT_BRANCH}`
Suite  : `${params.SUITE_FILE}`
<${env.BUILD_URL}allure|Allure Report> | <${env.BUILD_URL}console|Console Log>
                """.stripIndent().trim()
            )
            emailext(
                to: 'qa-team@yourcompany.com',
                subject: "FAILED: CPS-Automation #${env.BUILD_NUMBER} [${env.GIT_BRANCH}]",
                body: """
Build #${env.BUILD_NUMBER} FAILED on branch ${env.GIT_BRANCH}.

Suite  : ${params.SUITE_FILE}
Browser: ${params.BROWSER}

Allure Report : ${env.BUILD_URL}allure
Console Log   : ${env.BUILD_URL}console
                """.stripIndent().trim()
            )
        }

        always {
            /* Archive screenshots taken by Hooks.java on failure */
            archiveArtifacts(
                artifacts: 'target/screenshots/**,target/cucumber-reports/**,target/surefire-reports/**',
                allowEmptyArchive: true
            )
            /* Publish TestNG XML results as Jenkins test trend graph */
            junit(
                testResults: 'target/surefire-reports/*.xml',
                allowEmptyResults: true
            )
            /* Clean workspace to save disk space */
            cleanWs()
        }
    }
}
