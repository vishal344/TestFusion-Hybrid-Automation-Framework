pipeline {
    agent any

    /*
     * Triggers:
     *   1. Every git push to the repo (via GitHub webhook)
     *   2. Every night at 2 AM as a safety net
     */
    triggers {
        githubPush()
        cron('H 2 * * *')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))  // keep last 10 builds
        timeout(time: 60, unit: 'MINUTES')              // kill hung builds
        disableConcurrentBuilds()                       // 1 build at a time
        timestamps()                                    // timestamps in console
    }

    /*
     * Parameters let you choose suite/browser/tag from Jenkins UI
     * without editing any code.
     */
    parameters {
        choice(
            name: 'SUITE_FILE',
            choices: [
                'testng.xml',
                'testng-smoke.xml'
            ],
            description: 'Which TestNG suite to run?'
        )
        choice(
            name: 'BROWSER',
            choices: ['chrome', 'firefox'],
            description: 'Browser'
        )
        choice(
            name: 'TAG',
            choices: [
                '@RFQDetailsModule',
                '@Smoke',
                '@Customer',
                '@Employee',
                '@ProcurementModule'
            ],
            description: 'Cucumber tag to run'
        )
        string(
            name: 'RFQ_ID',
            defaultValue: 'NT79',
            description: 'RFQ ID to use in tests'
        )
    }

    environment {
        BASE_URL       = 'http://162.244.66.135:8989/rev-aux/buyerlogin'
        ALLURE_DIR     = 'target/allure-results'
        REPORT_DIR     = 'target/cucumber-reports'
        SCREENSHOT_DIR = 'target/screenshots'
    }

    stages {

        /* ── Stage 1: Get the code ──────────────────────────── */
        stage('Checkout') {
            steps {
                checkout scm
                echo "Branch  : ${env.GIT_BRANCH}"
                echo "Commit  : ${env.GIT_COMMIT?.take(7)}"
                echo "Suite   : ${params.SUITE_FILE}"
                echo "Browser : ${params.BROWSER}"
                echo "Tag     : ${params.TAG}"
                echo "RFQ ID  : ${params.RFQ_ID}"
            }
        }

        /* ── Stage 2: Verify Java and Maven ─────────────────── */
        stage('Verify Tools') {
            steps {
                bat 'java -version'
                bat 'mvn -version'
            }
        }

        /* ── Stage 3: Compile the project ───────────────────── */
        stage('Build') {
            steps {
                dir('cps-automation') {
                    bat 'mvn clean compile -q'
                }
            }
        }

        /* ── Stage 4: Run Selenium + Cucumber + TestNG tests ── */
        stage('Run Tests') {
            steps {
                dir('cps-automation') {
                    bat """
                        mvn test ^
                          -DsuiteFile=${params.SUITE_FILE} ^
                          -Dbrowser=${params.BROWSER} ^
                          -DbaseUrl=${env.BASE_URL} ^
                          -Dcucumber.filter.tags=${params.TAG} ^
                          -DtestFailureIgnore=true ^
                          -DrfqId=${params.RFQ_ID}
                    """
                }
            }
            post {
                always {
                    echo 'Test execution finished — moving to report generation'
                }
            }
        }

        /* ── Stage 5: Generate Allure Report ────────────────── */
        stage('Generate Allure Report') {
            steps {
                dir('cps-automation') {
                    bat """
                        mvn allure:report ^
                          -Dallure.results.directory=target/allure-results ^
                          -Dallure.report.directory=target/site/allure-maven-plugin
                    """
                }
            }
        }

        /* ── Stage 6: Publish Reports in Jenkins UI ─────────── */
        stage('Publish Reports') {
            steps {
                // Publish Allure Report
                allure([
                    includeProperties: false,
                    jdk: '',
                    results: [[path: "cps-automation/${env.ALLURE_DIR}"]]
                ])

                // Publish Cucumber HTML Report
                publishHTML([
                    allowMissing         : true,
                    alwaysLinkToLastBuild: true,
                    keepAll              : true,
                    reportDir            : 'cps-automation/target/cucumber-reports',
                    reportFiles          : 'cucumber.html',
                    reportName           : 'Cucumber Report'
                ])
            }
        }

        /* ── Stage 7: Quality Gate ───────────────────────────── */
        stage('Quality Gate') {
            steps {
                script {
                    // Read TestNG results XML to check for failures
                    def testngFile = 'cps-automation/target/surefire-reports/testng-results.xml'
                    if (fileExists(testngFile)) {
                        def xml = readFile(testngFile)
                        if (xml.contains('status="FAIL"')) {
                            echo 'QUALITY GATE: Some tests FAILED'
                            currentBuild.result = 'UNSTABLE'
                        } else {
                            echo 'QUALITY GATE: All tests PASSED'
                        }
                    } else {
                        echo 'QUALITY GATE: No results file found — skipping'
                    }
                }
            }
        }
    }

    /* ── Post-build actions ──────────────────────────────────── */
    post {

        success {
            echo '✅ BUILD PASSED'
            emailext(
                to: 'qa-team@yourcompany.com',
                subject: "✅ PASSED: CPS-Automation #${env.BUILD_NUMBER} [${params.TAG}]",
                body: """
Build Status : PASSED
Build Number : ${env.BUILD_NUMBER}
Branch       : ${env.GIT_BRANCH}
Suite        : ${params.SUITE_FILE}
Browser      : ${params.BROWSER}
Tag          : ${params.TAG}

Allure Report  : ${env.BUILD_URL}allure
Cucumber Report: ${env.BUILD_URL}Cucumber_20Report
Jenkins Build  : ${env.BUILD_URL}
                """.stripIndent().trim()
            )
        }

        failure {
            echo '❌ BUILD FAILED'
            emailext(
                to: 'qa-team@yourcompany.com',
                subject: "❌ FAILED: CPS-Automation #${env.BUILD_NUMBER} [${params.TAG}]",
                body: """
Build Status : FAILED
Build Number : ${env.BUILD_NUMBER}
Branch       : ${env.GIT_BRANCH}
Suite        : ${params.SUITE_FILE}
Browser      : ${params.BROWSER}
Tag          : ${params.TAG}

Allure Report : ${env.BUILD_URL}allure
Console Log   : ${env.BUILD_URL}console
Jenkins Build : ${env.BUILD_URL}
                """.stripIndent().trim()
            )
        }

        unstable {
            echo '⚠️ BUILD UNSTABLE — Some tests failed'
            emailext(
                to: 'qa-team@yourcompany.com',
                subject: "⚠️ UNSTABLE: CPS-Automation #${env.BUILD_NUMBER} [${params.TAG}]",
                body: """
Build Status : UNSTABLE (some tests failed)
Build Number : ${env.BUILD_NUMBER}
Branch       : ${env.GIT_BRANCH}
Suite        : ${params.SUITE_FILE}
Browser      : ${params.BROWSER}
Tag          : ${params.TAG}

Allure Report : ${env.BUILD_URL}allure
Console Log   : ${env.BUILD_URL}console
                """.stripIndent().trim()
            )
        }

        always {
            // Archive screenshots, cucumber and surefire reports
            archiveArtifacts(
                artifacts: 'cps-automation/target/screenshots/**,cps-automation/target/cucumber-reports/**,cps-automation/target/surefire-reports/**',
                allowEmptyArchive: true
            )
            // Publish TestNG XML results as Jenkins test trend graph
            junit(
                testResults: 'cps-automation/target/surefire-reports/*.xml',
                allowEmptyResults: true
            )
        }
    }
}